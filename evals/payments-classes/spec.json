    { "id": "card", "kind": "class", "label": "Card", "attributes": ["last4: string", "expiry: Date"], "methods": ["authorise(amount)"], "row": 1, "col": 2 },
    { "id": "bank-transfer", "kind": "class", "label": "BankTransfer", "attributes": ["iban: string"], "methods": ["authorise(amount)"], "row": 1, "col": 3 },
