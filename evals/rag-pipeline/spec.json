      "label": "Specifications and docs",
      "row": 2,
      "col": 0
    },
    {
      "id": "preprocessing",
      "label": "Pre-processing",
      "row": 1,
      "col": 1,
      "subtitle": "clean and chunk"
    },
    {
      "id": "embedding",
      "label": "Embedding model",
      "row": 1,
      "col": 2
    },
    {
      "id": "vector-db",
      "label": "Vector database",
      "row": 1,
      "col": 3,
      "subtitle": "knowledge index",
