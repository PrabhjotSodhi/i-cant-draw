  "edges": [
    {
      "from": "dsl",
      "to": "preprocessing"
    },
    {
      "from": "specs",
      "to": "preprocessing"
    },
    {
      "from": "preprocessing",
      "to": "embedding",
      "main": true
    },
    {
      "from": "embedding",
      "to": "vector-db",
      "main": true
    },
    {
      "from": "vector-db",
      "to": "processor",
      "label": "RAG context retrieval",
      "style": "dashed",
      "main": true
    },
    {
      "from": "user-query",
      "to": "processor"
    },
    {
      "from": "processor",
      "to": "output-gen",
      "main": true
    },
    {
      "from": "output-gen",
      "to": "judge",
      "main": true
    },
    {
      "from": "judge",
      "to": "error-loop",
      "label": "validation failed"
    },
    {
      "from": "error-loop",
      "to": "processor",
      "label": "refinement needed"
    },
    {
      "from": "judge",
      "to": "done",
      "label": "validation passed",
      "main": true
    },
    {
      "from": "done",
      "to": "human-review",
      "main": true
    },
    {
      "from": "human-review",
      "to": "verified-output",
      "main": true
    }
  ],
  "groups": [
    {
      "id": "ingestion-phase",
      "label": "Knowledge ingestion phase",
      "contains": [
        "dsl",
        "specs",
        "preprocessing",
        "embedding",
        "vector-db"
      ],
      "tone": "blue"
    },
    {
      "id": "inference-phase",
      "label": "Inference and orchestration",
      "contains": [
        "user-query",
        "processor",
        "output-gen"
      ],
      "tone": "purple"
    },
    {
      "id": "qc-phase",
      "label": "Quality control phase",
      "contains": [
        "judge",
        "error-loop",
        "done"
      ],
      "tone": "orange"
    },
    {
      "id": "human-loop",
      "label": "Human in the loop",
      "contains": [
        "human-review",
        "verified-output"
      ],
      "tone": "green"
    }
