      "row": 1,
      "col": 7
    },
    {
      "id": "human-review",
      "label": "Human expert review",
      "row": 1,
      "col": 8,
      "icon": "person"
    },
    {
      "id": "verified-output",
      "label": "Verified output",
      "row": 2,
      "col": 8,
      "subtitle": "production ready"
    }
