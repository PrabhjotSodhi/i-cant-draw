  "edges": [
    {
      "from": "statements",
      "to": "import",
      "main": true
    },
    {
      "from": "uploads",
      "to": "import"
    },
    {
      "from": "import",
      "to": "transactions",
      "main": true
    },
    {
      "from": "import",
      "to": "receipts"
    },
    {
      "from": "transactions",
      "to": "receipts",
      "label": "not linked",
      "style": "dashed",
      "annotation": true
    },
    {
      "from": "transactions",
      "to": "matcher",
      "main": true
    },
    {
      "from": "receipts",
      "to": "matcher"
    },
    {
      "from": "matcher",
      "to": "check-agent",
      "main": true
    },
    {
      "from": "check-agent",
      "to": "verdict",
      "main": true
    }
  ],
  "groups": [
    {
      "id": "expense-store",
      "label": "Expense data store",
      "contains": [
        "transactions",
        "receipts"
      ],
      "tone": "purple"
    }
